{
  "_schema": "node_registry v1 - 已驗證可用的節點建立方式。Agent 建立節點前先查此表，查不到才用 search_nodes。",
  "_fields": {
    "create": "傳給 execute_dynamo_instructions 的 name（已驗證可建立）",
    "inputs": "輸入埠順序（toPort index = 陣列索引）",
    "outputs": "輸出埠順序（fromPort index）",
    "value": "如何設定值",
    "badNames": "會建錯/建不出來的名稱",
    "gotchas": "已知陷阱",
    "verified": "驗證環境"
  },
  "globalRules": [
    "search_nodes 回傳的 fullName（例：DSCoreNodes.DSCore.String.Split）無法建立節點；請用本表 create，或 get_graph_status 回傳的 creationName（例：DSCore.String.Split@string,string[]）。",
    "UI 節點（下拉選單等）若顯示名稱建錯或建不出來，改用類別全名（get_graph_status 的 fullName，例：DSRevitNodesUI.Views、CoreNodeModels.Input.StringInput）；search_nodes 的『分類.名稱』（例：Selection.Categories）無法建立 UI 節點。",
    "節點 id 請用 GUID 字串：非 GUID 的 id 每次送出都會產生新節點（無法 upsert 更新）。",
    "同一 GUID 再送一次 = 更新（位置、value、Python code、連線）。Boolean 的 value 只在第二次送出（upsert）時生效。",
    "Code Block 內呼叫 List.* 必須寫成 DSCore.List.*，否則『找到 List 的多個定義』而輸出 null。",
    "Code Block 每一行 statement 一個輸出埠；輸入埠依變數第一次出現的順序。",
    "Code Block 中對 var[]..[] 參數逐項運算用複製導引 <1>（例：DSCore.List.Count(g<1>)）；@L2 在 Dynamo 2.6 無效。",
    "Python Script 程式碼避免反斜線跳脫（\\n 等），曾導致 EOL while scanning string；換行用 unichr(10)，路徑用正斜線。",
    "Dynamo 2.6 (Revit 2021) Python 為 IronPython2。",
    "禁止在 Python 節點內透過 DynamoRevit/Dispatcher 刪除節點或修改工作區，會導致 Dynamo 當掉。",
    "無法透過 MCP 讀取節點輸出值；需要驗證時請使用者執行並回報，或檢查匯出的檔案。"
  ],
  "nodes": {
    "String": {"create": "CoreNodeModels.Input.StringInput", "outputs": [""], "value": "value 欄位，建立時即生效", "badNames": ["String", "Core.Input.String"], "verified": "Dynamo 2.6 / Revit 2021"},
    "Boolean": {"create": "CoreNodeModels.Input.BoolSelector", "outputs": [""], "value": "value: \"true\"；需以相同 GUID 再送一次才生效", "badNames": ["Boolean", "Core.Input.Boolean"], "verified": "Dynamo 2.6 / Revit 2021"},
    "Code Block": {"create": "Code Block", "value": "value 欄位放 DesignScript，結尾 ;", "gotchas": ["List.* 要寫 DSCore.List.*", "多行 = 多輸出埠"], "verified": "Dynamo 2.6 / Revit 2021"},
    "Python Script": {"create": "Python Script", "inputs": ["IN[0]", "IN[1]..."], "outputs": ["OUT"], "value": "pythonCode 欄位；inputCount 設定輸入數；未接的 IN 會讓節點不執行", "verified": "Dynamo 2.6 / Revit 2021 (IronPython2)"},
    "Watch": {"create": "Watch", "inputs": [""], "outputs": [""], "verified": "Dynamo 2.6 / Revit 2021", "badNames": ["View.Watch"]},
    "Or": {"create": "Or", "inputs": ["bool0", "bool1"], "gotchas": ["對布林清單不會逐項運算，輸出 null。清單請改用其他方式（例：先 String.Replace 正規化再單一 String.Contains）"], "verified": "Dynamo 2.6 / Revit 2021"},
    "List.GetItemAtIndex": {"create": "List.GetItemAtIndex", "inputs": ["list", "index"], "outputs": ["item"], "verified": "Dynamo 2.6"},
    "List.FilterByBoolMask": {"create": "List.FilterByBoolMask", "inputs": ["list", "mask"], "outputs": ["in", "out"], "verified": "Dynamo 2.6"},
    "List.GroupByKey": {"create": "List.GroupByKey", "inputs": ["list", "keys"], "outputs": ["groups", "unique keys"], "verified": "Dynamo 2.6"},
    "List.AddItemToFront": {"create": "List.AddItemToFront", "inputs": ["item", "list"], "outputs": ["list"], "verified": "Dynamo 2.6"},
    "List.Count": {"create": "List.Count", "inputs": ["list"], "outputs": ["count"], "verified": "Dynamo 2.6"},
    "List.Contains": {"create": "List.Contains", "inputs": ["list", "item"], "gotchas": ["item 為 var[]..[]，傳入清單不會逐項判斷；逐項請用 Code Block: DSCore.List.Contains(all, items<1>);"], "verified": "Dynamo 2.6"},
    "Object.IsNull": {"create": "Object.IsNull", "inputs": ["obj"], "outputs": ["bool"], "verified": "Dynamo 2.6"},
    "String.Contains": {"create": "String.Contains", "inputs": ["str", "searchFor", "ignoreCase"], "outputs": ["bool"], "verified": "Dynamo 2.6"},
    "String.Replace": {"create": "String.Replace", "inputs": ["str", "searchFor", "replaceWith"], "outputs": ["str"], "gotchas": ["區分大小寫"], "verified": "Dynamo 2.6"},
    "String.IndexOf": {"create": "String.IndexOf", "inputs": ["str", "searchFor", "ignoreCase"], "outputs": ["index"], "verified": "Dynamo 2.6"},
    "String.Substring": {"create": "String.Substring", "inputs": ["str", "startIndex", "length"], "outputs": ["substring"], "verified": "Dynamo 2.6"},
    "String.TrimWhitespace": {"create": "String.TrimWhitespace", "inputs": ["str"], "outputs": ["str"], "verified": "Dynamo 2.6"},
    "String.Split": {"create": "String.Split", "inputs": ["str", "separator0"], "outputs": ["strings"], "gotchas": ["可變參數節點；目前 MCP 無法增加 separator 埠（待部署 inputCount 支援）"], "verified": "Dynamo 2.6"},
    "DateTime.Now": {"create": "DateTime.Now", "outputs": ["dateTime"], "verified": "Dynamo 2.6"},
    "DateTime.Format": {"create": "DateTime.Format", "inputs": ["dateTime", "format"], "outputs": ["string"], "verified": "Dynamo 2.6"},
    "Data.ExportExcel": {"create": "Data.ExportExcel", "inputs": ["filePath", "sheetName", "startRow", "startCol", "data", "overWrite"], "outputs": ["data"], "gotchas": ["需安裝 Microsoft Excel", "多個節點可寫同一檔案的不同工作表", "自動執行模式下建立節點就會開啟 Excel 寫檔"], "verified": "Dynamo 2.6 / Revit 2021"},
    "Document.Current": {"create": "Document.Current", "outputs": ["Document"], "verified": "Revit 2021"},
    "Document.FilePath": {"create": "Document.FilePath", "inputs": ["document"], "outputs": ["string"], "verified": "Revit 2021"},
    "Category.ByName": {"create": "Category.ByName", "inputs": ["name"], "outputs": ["Category"], "value": "可接受 BuiltInCategory 名稱，例：\"OST_Views\"", "verified": "Revit 2021"},
    "All Elements of Category": {"create": "All Elements of Category", "inputs": ["Category"], "outputs": ["Elements"], "gotchas": ["視圖品類會回傳少數 null 元素，下游先用 Object.IsNull + FilterByBoolMask 過濾"], "verified": "Revit 2021", "badNames": ["Selection.All Elements of Category"]},
    "Rooms By Status": {"create": "Rooms By Status", "outputs": ["PlacedRooms", "UnplacedRooms", "NotEnclosedRooms", "RedundantRooms"], "verified": "Revit 2021"},
    "Element.Name": {"create": "Element.Name", "inputs": ["element"], "outputs": ["string"], "verified": "Revit 2021"},
    "Element.Id": {"create": "Element.Id", "inputs": ["element"], "outputs": ["int"], "verified": "Revit 2021"},
    "Room.Number": {"create": "Room.Number", "inputs": ["room"], "outputs": ["string"], "verified": "Revit 2021"},
    "Room.Name": {"create": "Revit.Elements.Room.Name", "inputs": ["room"], "outputs": ["string"], "gotchas": ["輸入為空清單時顯示 get_Name 多載不明確警告；有實際房間時正常"], "verified": "Revit 2021"},
    "String.Join": {"create": "String.Join", "inputs": ["separator", "string0"], "outputs": ["str"], "creationName": "DSCore.String.Join@string,string[]", "nodeName": "String.Join", "status": "auto-verified", "verified": "Dynamo 2.6 / Revit 2021 (2026-10-08)"},
    "String.ToUpper": {"create": "String.ToUpper", "inputs": ["str"], "outputs": ["str"], "creationName": "DSCore.String.ToUpper@string", "nodeName": "String.ToUpper", "status": "auto-verified", "verified": "Dynamo 2.6 / Revit 2021 (2026-10-08)"},
    "Categories": {"create": "Categories", "inputs": [], "outputs": ["Category"], "nodeName": "Categories", "verified": "Dynamo 2.6 / Revit 2021 (2026-10-08)", "badNames": ["Selection.Categories"], "value": "下拉選單只能用索引設值（value: \"5\"），且需同 GUID 第二次送出才生效；索引對應的品類依 Revit 語系而異", "gotchas": ["要由 AI 固定品類，請改用 String(\"OST_Walls\") → Category.ByName", "送品類名稱（例 \"Walls\"）會 FormatException"]},
    "All Elements of Category in View": {"create": "All Elements of Category in View", "inputs": ["Category", "View"], "outputs": ["Elements"], "nodeName": "All Elements of Category in View", "verified": "Dynamo 2.6 / Revit 2021 (2026-10-08)", "badNames": ["Selection.All Elements of Category in View"]},
    "Document.ActiveView": {"create": "Document.ActiveView", "inputs": ["document"], "outputs": ["View"], "creationName": "Revit.Application.Document.ActiveView", "nodeName": "Document.ActiveView", "verified": "Dynamo 2.6 / Revit 2021 (2026-10-08)"},
    "Views": {"create": "DSRevitNodesUI.Views", "inputs": [], "outputs": ["Views"], "badNames": ["Views"], "gotchas": ["'Views' 會建出 Sheet.Views（圖紙上的視圖），不是視圖下拉選單；請用類別全名 DSRevitNodesUI.Views"], "verified": "Dynamo 2.6 / Revit 2021 (2026-10-08)"}
  },
  "patterns": {
    "表格匯出 Excel": "表頭 Code Block [\"欄1\",\"欄2\"] + 資料列 → List.AddItemToFront(item=表頭, list=資料列) → Data.ExportExcel(data)。多欄資料列可用 Code Block: DSCore.List.Transpose([a, b, c]);",
    "依名稱關鍵字篩選元素": "Element.Name → String.Replace(正規化同義關鍵字) → String.Contains → List.FilterByBoolMask(list=元素, mask)",
    "Python 多值輸出": "Python OUT = a, b, c → List.GetItemAtIndex(index=Code Block 0/1/2) 拆出",
